# Diretório de dados local. Em desenvolvimento o padrão é a raiz do projeto.
# Em produção o padrão é app.getPath('userData').
# W3_DATA_DIR=C:\W3LabsData

# Concorrência do scanner (1 a 4).
W3_SCAN_CONCURRENCY=2

# Caminhos explícitos dos núcleos externos (opcional).
# W3_CORE_DUCKSTATION=C:\Program Files\DuckStation\duckstation-qt-x64-ReleaseLTCG.exe
# W3_CORE_PCSX2=C:\Program Files\PCSX2\pcsx2-qt.exe
# W3_CORE_MESEN=C:\Program Files\Mesen\Mesen.exe
# W3_CORE_XEMU=C:\Program Files\xemu\xemu.exe
# W3_CORE_RPCS3=C:\Program Files\RPCS3\rpcs3.exe
# W3_CORE_SAMEBOY=C:\Program Files\SameBoy\sameboy.exe

# Logs verbosos de núcleos.
W3_DEBUG=0
